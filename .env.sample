# Required: Gemini API key from https://aistudio.google.com (free tier is enough; GEMINI_API_KEY also accepted)
API_KEY=

# Optional: pin a File Search store (fileSearchStores/...); otherwise one named STORE_NAME is found or created
STORE_ID=
STORE_NAME=optibot-kb

# Optional: model used by chat.py
GEMINI_MODEL=gemini-3-flash-preview

# Optional: limit articles for quick local runs (also disables deleting missing articles)
MAX_ARTICLES=

# Optional: 1 = scrape + convert only, no upload. Empty (default) = full run with upload
DRY_RUN=
